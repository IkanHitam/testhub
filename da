        Custom:Create("TextLabel", {Text = Title, Size = UDim2.new(1, -110, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1,1,1), TextXAlignment = "Left", Font = Enum.Font.Gotham, TextSize = 12, Parent = F})
        
