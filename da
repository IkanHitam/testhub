function Speed_Library:SetNotification(Config)
  local Title = Config.Title or ""
  local Content = Config.Content or ""
  local Delay = Config.Delay or 5

  local NotificationGui = Custom:Create("ScreenGui", {ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, Player:WaitForChild("PlayerGui"))
  local Frame = Custom:Create("Frame", {Size = UDim2.new(0, 250, 0, 60), Position = UDim2.new(1, 0, 0.8, 0), BackgroundColor3 = Color3.fromRGB(20, 20, 20)}, NotificationGui)
  Custom:Create("UICorner", {CornerRadius = UDim.new(0, 8)}, Frame)
  Custom:Create("TextLabel", {Text = Content, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), TextColor3 = Color3.new(1,1,1), BackgroundTransparency = 1, TextWrapped = true}, Frame)
  TweenService:Create(Frame, TweenInfo.new(0.5), {Position = UDim2.new(1, -270, 0.8, 0)}):Play()
  task.delay(Delay, function()
    if Frame then TweenService:Create(Frame, TweenInfo.new(0.5), {Position = UDim2.new(1, 0, 0.8, 0)}):Play() task.wait(0.5) NotificationGui:Destroy() end
  end)
end

