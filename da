      -- ═══════════════════════════════════════════════════════════
      -- BLOK LIVE TABLE MILIKMU (ANTI-ERROR)
      -- ═══════════════════════════════════════════════════════════
      function Item:AddLiveTable(Cfg)
        local Title = Cfg.Title or "Live Table"
        local Columns = Cfg.Columns or {"Pet", "Age", "Harga"}
        local Actions = Cfg.Actions or {}
        
        local TableFuncs = {}
        local TableData = {}
        local SortCol = "Harga" 
        local SortDir = "asc" 

        local TableContainer = Custom:Create("Frame", {
          Name = "LiveTableContainer",
          Size = UDim2.new(1, 0, 0, 300),
          BackgroundColor3 = Color3.fromRGB(20, 20, 20),
          Parent = SectionAdd
        })
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, TableContainer)

        local Search = Custom:Create("TextBox", {
          Name = "TableSearch",
          PlaceholderText = " 🔍 Cari Nama Pet...",
          Size = UDim2.new(1, -10, 0, 25),
          Position = UDim2.new(0, 5, 0, 5),
          BackgroundColor3 = Color3.fromRGB(10, 10, 10),
          TextColor3 = Color3.new(1, 1, 1),
          Font = Enum.Font.Gotham,
          TextSize = 12,
          Parent = TableContainer
        })
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, Search)

        local ColFrame = Custom:Create("Frame", {
          Name = "TableHeader",
          Size = UDim2.new(1, 0, 0, 25),
          Position = UDim2.new(0, 0, 0, 35),
          BackgroundColor3 = Color3.fromRGB(35, 35, 35),
          Parent = TableContainer
        })
        
        local ColumnWidth = 1 / (#Columns + (#Actions > 0 and 1 or 0))

        for i, Column in ipairs(Columns) do
          local ColumnHeader = Custom:Create("TextButton", {
            Text = Column,
            Size = UDim2.new(ColumnWidth, 0, 1, 0),
            Position = UDim2.new(ColumnWidth * (i - 1), 0, 0, 0),
            BackgroundTransparency = 1,
            TextColor3 = Color3.fromRGB(200, 200, 200),
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            Name = Column,
            Parent = ColFrame
          })

          ColumnHeader.Activated:Connect(function()
            if SortCol == Column then
              SortDir = (SortDir == "asc") and "desc" or "asc"
            else
              SortCol = Column
              SortDir = "asc"
            end
            TableFuncs:RefreshTable()
          end)
        end

        if #Actions > 0 then
          Custom:Create("TextLabel", { Text = "⚙️ Actions", Size = UDim2.new(ColumnWidth, 0, 1, 0), Position = UDim2.new(ColumnWidth * #Columns, 0, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(200, 200, 200), Font = Enum.Font.GothamBold, TextSize = 11, Parent = ColFrame })
        end

        local Scroll = Custom:Create("ScrollingFrame", {
          Name = "TableScroll",
          Size = UDim2.new(1, 0, 1, -65),
          Position = UDim2.new(0, 0, 0, 60),
          BackgroundTransparency = 1,
          ScrollBarThickness = 2,
          CanvasSize = UDim2.new(0, 0, 0, 0),
          Parent = TableContainer
        })
        local UIList = Custom:Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, Scroll)

        function TableFuncs:RefreshTable()
          local success, err = pcall(function()
            for _, v in pairs(Scroll:GetChildren()) do 
              if v:IsA("Frame") and v.Name == "Row" then v:Destroy() end 
            end
            
            local q = Search.Text:lower()
            local filtered = {}
            for _, r in ipairs(TableData) do
              if tostring(r.Pet or r.Name or ""):lower():find(q) then table.insert(filtered, r) end
            end

            if SortCol then
              for _, btn in ipairs(ColFrame:GetChildren()) do
                if btn:IsA("TextButton") then
                  btn.Text = btn.Name .. (btn.Name == SortCol and (SortDir == "asc" and " ^" or " v") or "")
                end
              end
              
              table.sort(filtered, function(a, b)
                local v1 = a[SortCol] or 0
                local v2 = b[SortCol] or 0
                local n1 = tonumber(v1)
                local n2 = tonumber(v2)
                
                if n1 and n2 then
                  if SortDir == "asc" then return n1 < n2 else return n1 > n2 end
                else
                  local s1 = tostring(v1):lower()
                  local s2 = tostring(v2):lower()
                  if SortDir == "asc" then return s1 < s2 else return s1 > s2 end
                end
              end)
            end

            for i, row in ipairs(filtered) do
              local RowFrame = Custom:Create("Frame", {
                Name = "Row",
                Size = UDim2.new(1, 0, 0, 25),
                BackgroundColor3 = (i % 2 == 0) and Color3.fromRGB(25, 25, 25) or Color3.fromRGB(30, 30, 30),
                BorderSizePixel = 0,
                Parent = Scroll
              })
              
              for colIndex, Column in ipairs(Columns) do
                Custom:Create("TextLabel", {
                  Text = " " .. tostring(row[Column] or ""), 
                  Size = UDim2.new(ColumnWidth, 0, 1, 0), 
                  Position = UDim2.new(ColumnWidth * (colIndex - 1), 0, 0, 0), 
                  BackgroundTransparency = 1, 
                  TextColor3 = (Column == "Harga") and Color3.fromRGB(255, 255, 100) or Color3.new(1,1,1), 
                  TextXAlignment = (colIndex == 1) and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center, 
                  Font = Enum.Font.Gotham, 
                  TextSize = 11, 
                  Parent = RowFrame
                })
              end
              
              if #Actions > 0 then
                local BuyBtn = Custom:Create("TextButton", {
                  Text = Actions[1].Icon or "🛒",
                  Size = UDim2.new(0, 30, 0, 18),
                  Position = UDim2.new(ColumnWidth * #Columns + (ColumnWidth/2) - 15, -9, 0.5, 0), -- Disesuaikan
                  AnchorPoint = Vector2.new(0.5, 0.5),
                  BackgroundColor3 = Custom.ColorRGB,
                  TextColor3 = Color3.new(1,1,1),
                  Font = Enum.Font.GothamBold,
                  Parent = RowFrame
                })
                Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, BuyBtn)
                BuyBtn.Activated:Connect(function() Actions[1].Callback(i, row) end)
              end
            end
            
            Scroll.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y)
          end)

          if not success then
             warn("ERROR DI TABEL: " .. tostring(err))
          end
        end

        function TableFuncs:SetData(newData)
          TableData = newData or {}
          self:RefreshTable()
        end

        Search:GetPropertyChangedSignal("Text"):Connect(function() TableFuncs:RefreshTable() end)
        
        ItemCount += 1
        return TableFuncs
      end

      ItemCount += 1
      return Item
    end
    CountTab += 1
    return Sections
  end
  return Tabs
end
return Speed_Library
