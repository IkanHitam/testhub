            local b = Custom:Create("TextButton", {Text = tostring(v), Size = UDim2.new(1,0,0,30), BackgroundTransparency = 0.9, BackgroundColor3 = Color3.new(1,1,1), TextColor3 = Color3.new(1,1,1), Font = Enum.Font.Gotham, TextSize = 12}, List)
