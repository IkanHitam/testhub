local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Custom = {} do
  Custom.ColorRGB = Color3.fromRGB(250, 7, 7)
  function Custom:Create(Name, Properties, Parent)
    local _instance = Instance.new(Name)
    for i, v in pairs(Properties) do _instance[i] = v end
    if Parent then _instance.Parent = Parent end
    return _instance
  end
end

local Speed_Library = {}

function Speed_Library:SetNotification(Config)
  local NotificationGui = Custom:Create("ScreenGui", {ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, Player:WaitForChild("PlayerGui"))
  local Frame = Custom:Create("Frame", {Size = UDim2.new(0, 250, 0, 50), Position = UDim2.new(1, 0, 0.8, 0), BackgroundColor3 = Color3.fromRGB(25, 25, 25)}, NotificationGui)
  Custom:Create("UICorner", {CornerRadius = UDim.new(0, 6)}, Frame)
  Custom:Create("TextLabel", {Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), Text = Config.Content or "", TextColor3 = Color3.new(1,1,1), BackgroundTransparency = 1, TextWrapped = true, Font = "Gotham", TextSize = 12}, Frame)
  TweenService:Create(Frame, TweenInfo.new(0.4), {Position = UDim2.new(1, -260, 0.8, 0)}):Play()
  task.delay(Config.Delay or 3, function() TweenService:Create(Frame, TweenInfo.new(0.4), {Position = UDim2.new(1, 0, 0.8, 0)}):Play() task.wait(0.4) NotificationGui:Destroy() end)
end

function Speed_Library:CreateWindow(Config)
  local Screen = Custom:Create("ScreenGui", {ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, Player:WaitForChild("PlayerGui"))
  local Main = Custom:Create("Frame", {Size = Config.SizeUi or UDim2.fromOffset(580, 420), Position = UDim2.new(0.5, -290, 0.5, -210), BackgroundColor3 = Color3.fromRGB(15, 15, 15)}, Screen)
  Custom:Create("UICorner", {CornerRadius = UDim.new(0, 8)}, Main)
  Custom:Create("UIStroke", {Color = Color3.fromRGB(40, 40, 40), Thickness = 2}, Main)
  
  local Top = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundTransparency = 1}, Main)
  Custom:Create("TextLabel", {Text = Config.Title or "SNIPER", Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 12, 0, 0), TextColor3 = Color3.new(1,1,1), BackgroundTransparency = 1, TextXAlignment = "Left", Font = "GothamBold", TextSize = 14}, Top)
  
  local Container = Custom:Create("ScrollingFrame", {Size = UDim2.new(1, -20, 1, -45), Position = UDim2.new(0, 10, 0, 40), BackgroundTransparency = 1, CanvasSize = UDim2.new(0,0,0,0), ScrollBarThickness = 3}, Main)
  local Layout = Custom:Create("UIListLayout", {Padding = UDim.new(0, 10)}, Container)
  Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Container.CanvasSize = UDim2.new(0,0,0, Layout.AbsoluteContentSize.Y + 20) end)

  local Tabs = {}
  function Tabs:AddSection(Title, Open)
    local SecFrame = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 25), BackgroundColor3 = Color3.fromRGB(35, 35, 35)}, Container)
    Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, SecFrame)
    Custom:Create("TextLabel", {Text = "  " .. Title, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = Custom.ColorRGB, TextXAlignment = "Left", Font = "GothamBold", TextSize = 12}, SecFrame)
    
    local Content = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1}, Container)
    local CLay = Custom:Create("UIListLayout", {Padding = UDim.new(0, 5)}, Content)
    CLay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Content.Size = UDim2.new(1,0,0, CLay.AbsoluteContentSize.Y) end)

    local Items = {}
    
    function Items:AddToggle(Cfg)
        local TFrame = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(25, 25, 25)}, Content)
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, TFrame)
        local TBtn = Custom:Create("TextButton", {Text = (Cfg.Default and "ON" or "OFF"), Size = UDim2.new(0, 50, 0, 20), Position = UDim2.new(1, -55, 0.5, -10), BackgroundColor3 = (Cfg.Default and Custom.ColorRGB or Color3.fromRGB(50, 50, 50)), TextColor3 = Color3.new(1,1,1), Font = "GothamBold", TextSize = 10}, TFrame)
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, TBtn)
        Custom:Create("TextLabel", {Text = Cfg.Title, Size = UDim2.new(1, -70, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1,1,1), TextXAlignment = "Left", Font = "Gotham", TextSize = 12}, TFrame)
        TBtn.Activated:Connect(function()
            Cfg.Default = not Cfg.Default
            TBtn.Text = Cfg.Default and "ON" or "OFF"
            TBtn.BackgroundColor3 = Cfg.Default and Custom.ColorRGB or Color3.fromRGB(50, 50, 50)
            Cfg.Callback(Cfg.Default)
        end)
    end

    function Items:AddInput(Cfg)
        local IFrame = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = Color3.fromRGB(25, 25, 25)}, Content)
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, IFrame)
        local Box = Custom:Create("TextBox", {Text = Cfg.Default or "", PlaceholderText = Cfg.Title, Size = UDim2.new(0, 120, 0, 25), Position = UDim2.new(1, -125, 0.5, -12), BackgroundColor3 = Color3.fromRGB(15, 15, 15), TextColor3 = Color3.new(1,1,1), Font = "Gotham", TextSize = 12}, IFrame)
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, Box)
        Custom:Create("TextLabel", {Text = Cfg.Title, Size = UDim2.new(1, -140, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1,1,1), TextXAlignment = "Left", Font = "Gotham", TextSize = 12}, IFrame)
        Box.FocusLost:Connect(function() Cfg.Callback(Box.Text) end)
    end

    function Items:AddDropdown(Cfg)
        local DFrame = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = Color3.fromRGB(25, 25, 25)}, Content)
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, DFrame)
        local Sel = Custom:Create("TextButton", {Text = "Pilih Pet...", Size = UDim2.new(0, 120, 0, 25), Position = UDim2.new(1, -125, 0.5, -12), BackgroundColor3 = Color3.fromRGB(15, 15, 15), TextColor3 = Color3.new(1,1,1), Font = "Gotham", TextSize = 11}, DFrame)
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, Sel)
        Custom:Create("TextLabel", {Text = Cfg.Title, Size = UDim2.new(1, -140, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1,1,1), TextXAlignment = "Left", Font = "Gotham", TextSize = 12}, DFrame)
        
        Sel.Activated:Connect(function()
            local ScreenD = Custom:Create("ScreenGui", {}, Player.PlayerGui)
            local Bg = Custom:Create("TextButton", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 0.5, BackgroundColor3 = Color3.new(0,0,0), Text = ""}, ScreenD)
            local List = Custom:Create("ScrollingFrame", {Size = UDim2.new(0, 200, 0, 300), Position = UDim2.new(0.5, -100, 0.5, -150), BackgroundColor3 = Color3.fromRGB(30,30,30), CanvasSize = UDim2.new(0,0,0,0)}, ScreenD)
            local LLayout = Custom:Create("UIListLayout", {}, List)
            LLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() List.CanvasSize = UDim2.new(0,0,0, LLayout.AbsoluteContentSize.Y) end)
            for _, v in pairs(Cfg.Options) do
                local b = Custom:Create("TextButton", {Text = v, Size = UDim2.new(1,0,0,30), BackgroundTransparency = 1, TextColor3 = Color3.new(1,1,1), Font = "Gotham", TextSize = 12}, List)
                b.Activated:Connect(function() Cfg.Callback({v}); Sel.Text = v; ScreenD:Destroy() end)
            end
            Bg.Activated:Connect(function() ScreenD:Destroy() end)
        end)
    end

    function Items:AddLiveTable(Cfg)
        local TblFrame = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 300), BackgroundColor3 = Color3.fromRGB(20, 20, 20)}, Content)
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, TblFrame)
        local Search = Custom:Create("TextBox", {Size = UDim2.new(1, -10, 0, 25), Position = UDim2.new(0, 5, 0, 5), PlaceholderText = " 🔍 Cari Pet...", BackgroundColor3 = Color3.new(0,0,0), TextColor3 = Color3.new(1,1,1), Font = "Gotham", TextSize = 12}, TblFrame)
        local Header = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 35), BackgroundColor3 = Color3.fromRGB(40, 40, 40)}, TblFrame)
        Custom:Create("TextLabel", {Text = "Pet", Size = UDim2.new(0.5, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(0.7,0.7,0.7), Font = "GothamBold", TextSize = 11}, Header)
        Custom:Create("TextLabel", {Text = "Age", Size = UDim2.new(0.15, 0, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(0.7,0.7,0.7), Font = "GothamBold", TextSize = 11}, Header)
        Custom:Create("TextLabel", {Text = "Harga", Size = UDim2.new(0.15, 0, 1, 0), Position = UDim2.new(0.65, 0, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(0.7,0.7,0.7), Font = "GothamBold", TextSize = 11}, Header)
        
        local Scroll = Custom:Create("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -60), Position = UDim2.new(0, 0, 0, 55), BackgroundTransparency = 1, CanvasSize = UDim2.new(0,0,0,0), ScrollBarThickness = 2}, TblFrame)
        local TLay = Custom:Create("UIListLayout", {}, Scroll)
        
        local tbl = {RawData = {}}
        function tbl:SetData(newData)
            self.RawData = newData
            self:UpdateDisplay(Search.Text)
        end
        
        function tbl:UpdateDisplay(query)
            for _, v in pairs(Scroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
            local q = query:lower()
            for i, row in ipairs(self.RawData) do
                if row.Pet:lower():find(q) then
                    local r = Custom:Create("Frame", {Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = (i%2==0 and 0.95 or 1), BackgroundColor3 = Color3.new(0,0,0)}, Scroll)
                    Custom:Create("TextLabel", {Text = "  " .. row.Pet, Size = UDim2.new(0.5, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1,1,1), TextXAlignment = "Left", Font = "Gotham", TextSize = 11}, r)
                    Custom:Create("TextLabel", {Text = row.Age, Size = UDim2.new(0.15, 0, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1,1,1), Font = "Gotham", TextSize = 11}, r)
                    Custom:Create("TextLabel", {Text = row.Harga, Size = UDim2.new(0.15, 0, 1, 0), Position = UDim2.new(0.65, 0, 0, 0), BackgroundTransparency = 1, TextColor3 = Color3.new(1,1,1), Font = "Gotham", TextSize = 11}, r)
                    local b = Custom:Create("TextButton", {Text = "🛒", Size = UDim2.new(0.15, -6, 0, 20), Position = UDim2.new(0.82, 0, 0.5, -10), BackgroundColor3 = Custom.ColorRGB, TextColor3 = Color3.new(1,1,1), Font = "GothamBold", TextSize = 10}, r)
                    Custom:Create("UICorner", {CornerRadius = UDim.new(0, 4)}, b)
                    b.Activated:Connect(function() Cfg.Actions[1].Callback(i, row) end)
                end
            end
            Scroll.CanvasSize = UDim2.new(0, 0, 0, TLay.AbsoluteContentSize.Y)
        end
        Search:GetPropertyChangedSignal("Text"):Connect(function() tbl:UpdateDisplay(Search.Text) end)
        return tbl
    end
    return Items
  end
  return Tabs
end
return Speed_Library
